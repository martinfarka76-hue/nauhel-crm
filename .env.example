# === PostgreSQL ===
POSTGRES_DB=nauhel_crm
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=zmen_toto_heslo

# === Backend ===
# Vygeneruj si vlastní náhodný řetězec, např.: openssl rand -hex 32
JWT_SECRET=zmen_toto_na_nahodny_retezec
ENVIRONMENT=development

# === n8n ===
N8N_USER=admin
N8N_PASSWORD=zmen_toto_heslo

# === Cloudflare Tunnel ===
# Token získáš v Cloudflare Zero Trust dashboardu při vytváření tunelu
CLOUDFLARE_TUNNEL_TOKEN=

# === Microsoft Graph (OneDrive / Outlook) - doplní se později ===
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# === Fakturační API (iDoklad) - doplní se později ===
IDOKLAD_CLIENT_ID=
IDOKLAD_CLIENT_SECRET=

# === Anthropic API (AI vrstva) - doplní se později ===
ANTHROPIC_API_KEY=

# === MCP integrace (Claude jako CRM konektor) ===
# Statický service token pro mcp-server kontejner - vygeneruj vlastní, např.:
# openssl rand -hex 32
# Používá ho JEN mcp-server (interní síťová komunikace s backendem), nikdy
# se neposílá ven - připojení do Claude jde přes vlastní OAuth na straně
# mcp-serveru (viz mcp-server/main.py).
MCP_SERVICE_TOKEN=
# Veřejná URL mcp-serveru přes Cloudflare Tunnel (koordinace s Vítkem),
# např. https://mcp.oczkowi.eu - MUSÍ sedět s tunnel routou.
MCP_PUBLIC_URL=
# Heslo pro přihlášení Claude ke CRM (jediný uživatel - Martin).
# Vygeneruj silné náhodné heslo, např.: openssl rand -base64 24
MCP_LOGIN_PASSWORD=
